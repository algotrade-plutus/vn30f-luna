# Keys the Calibrum runner reads. On the EC2 they come from AWS Secrets Manager
# /algotrade/paperbroker (deploy/render-env.sh). Never commit values.

# FIX + REST: copy from the account's `.env` button on the PaperTrade dashboard.
PAPER_ACCOUNT_ID=
PAPER_USERNAME=
PAPER_PASSWORD=
PAPER_REST_BASE_URL=https://papertrade.algotrade.vn/accounting
SOCKET_HOST=
SOCKET_PORT=5001
SENDER_COMP_ID=
TARGET_COMP_ID=SERVER

# Kafka quotes (bid/ask to price orders only; signals come from DNSE).
PAPERBROKER_KAFKA_BOOTSTRAP_SERVERS=
PAPERBROKER_KAFKA_USERNAME=
PAPERBROKER_KAFKA_PASSWORD=
PAPERBROKER_ENV_ID=real

# Operating knobs, in /etc/calibrum/calibrum.env on the EC2 (not in the secret).
CALIBRUM_MODE=active
CALIBRUM_QTY=10
CALIBRUM_ALLOW_ORDERS=true
