# Web dashboard (không commit giá trị thật)
ALGOTRADE_WEB_USERNAME=
ALGOTRADE_WEB_PASSWORD=
ALGOTRADE_NICKNAME=

# FIX + REST: copy nguyên khối .env từ nút `.env` trên dashboard.
PAPER_ACCOUNT_ID=
PAPER_USERNAME=
PAPER_PASSWORD=
PAPER_REST_BASE_URL=
SOCKET_HOST=
SOCKET_PORT=
SENDER_COMP_ID=
TARGET_COMP_ID=

# Kafka market data
PAPERBROKER_KAFKA_BOOTSTRAP_SERVERS=
PAPERBROKER_KAFKA_USERNAME=
PAPERBROKER_KAFKA_PASSWORD=
PAPERBROKER_ENV_ID=real

# VN30 spot source. Keep kafka for the original topic; use redis or postgres
# when the Kafka HSX:VN30 topic is unavailable. Futures remain on Kafka.
VN30_SPOT_SOURCE=kafka
MARKET_REDIS_HOST=
MARKET_REDIS_PORT=6379
MARKET_REDIS_DB=0
MARKET_REDIS_PASSWORD=
VN30_PG_HOST=
VN30_PG_PORT=5432
VN30_PG_DATABASE=
VN30_PG_USER=
VN30_PG_PASSWORD=
VN30_PG_TICKER=VN30
VN30_PG_POLL_INTERVAL_S=1.0

# Instrument dự phòng khi VN30F_ROLLOVER_MODE=fixed.
VN30F1M=HNXDS:VN30F2609
VN30F_ROLLOVER_MODE=auto

# Calendar alpha: 1 hợp đồng, quyết định 14:24-14:29 ICT, LIMIT crossing.
CALENDAR_QTY=1
CALENDAR_CANCEL_AFTER_S=8
CALENDAR_CROSS_POINTS=0.1
CALENDAR_EVAL_INTERVAL_S=2
ACCOUNT_SNAPSHOT_REFRESH_S=30

# Safety gate: chỉ bật sau khi smoke test và reconcile account thành công.
PAPERBROKER_ALLOW_ORDERS=false

# Container starts harmlessly. Change only after an alpha factory exists.
PAPERTRADING_MODE=hold
ALPHA_FACTORY=alphas.calendar.service:build_calendar_service
