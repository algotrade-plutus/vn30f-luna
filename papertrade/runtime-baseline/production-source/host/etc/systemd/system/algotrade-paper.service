[Unit]
Description=Algotrade Paper Trading Runtime
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
Environment=AWS_REGION=ap-southeast-1
Environment=ALGOTRADE_SECRET_ID=/algotrade/paperbroker
Environment=ALGOTRADE_IMAGE_REF=943193395259.dkr.ecr.ap-southeast-1.amazonaws.com/algotrade-paper:v5-master-unified
ExecStart=/usr/local/bin/algotrade-run
ExecStop=-/usr/bin/docker stop -t 20 algotrade-paper
Restart=always
RestartSec=10
TimeoutStartSec=0
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
